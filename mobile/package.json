{
  "name": "drevos-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "preview": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "expo prebuild",
    "bundle:check": "expo export --platform all --output-dir dist",
    "build:web": "node scripts/build-web.mjs",
    "format:check": "prettier --check App.tsx index.ts src tests"
  },
  "dependencies": {
    "@noble/ciphers": "2.4.0",
    "base64-js": "1.5.1",
    "expo": "58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "jsqr": "^1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.9"
    }
  }
}
