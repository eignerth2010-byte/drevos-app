{
  "expo": {
    "name": "Drevos",
    "slug": "drevos-mobile",
    "version": "0.3.1",
    "scheme": "drevos",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#101315",
    "ios": {
      "bundleIdentifier": "at.eignerth.drevos",
      "buildNumber": "4",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Drevos verbindet sich direkt mit deinem Raspberry Pi, um deinen Räucherofen zu bedienen.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "at.eignerth.drevos",
      "versionCode": 4,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Drevos verwendet die Kamera ausschließlich zum Scannen deines lokalen Kopplungscodes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "icon": "./assets/app-icon.png"
  }
}
